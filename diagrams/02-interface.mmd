classDiagram
    class Sortable {
        <<interface>>
        +isBigger(Sortable other) boolean
    }
    class Person {
        -String name
        -String surname
        +Person(name, surname)
        +print() void
        +isBigger(Sortable other) boolean
    }
    class Rectangle {
        -double width
        -double height
        +Rectangle(width, height)
        +area() double
        +print() void
        +isBigger(Sortable other) boolean
    }
    class Sorter {
        +sort(Sortable[] items) void
    }
    class Main {
        +main(String[] args)$ void
    }
    Sortable <|.. Person : implements
    Sortable <|.. Rectangle : implements
    Sorter ..> Sortable : sorts
    Main ..> Sorter : uses
    Main ..> Person : creates
    Main ..> Rectangle : creates
